# ============================
# eBook Store Backend — .env
# ============================

# MongoDB Atlas
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DATABASE_NAME=ebook_store

# JWT Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
DOWNLOAD_TOKEN_EXPIRE_MINUTES=10

# Cloudinary
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cashfree
# Get from: https://merchant.cashfree.com/merchants/developer/api-keys
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox

# Admin credentials
# Generate hash with: python generate_hash.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# CORS — comma-separated list of frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","https://yourstore.vercel.app"]

# URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
